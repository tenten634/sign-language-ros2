<?xml version="1.0"?>
<package format="3">
  <name>llm_planner_ros2</name>
  <version>0.1.0</version>
  <description>
    LLM-based motion planner nodes that convert recognized sign-language text
    into validated motion plans (JSON). Execution uses odom/cmd_vel.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sign_language_msgs</depend>
  <depend>nav_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

